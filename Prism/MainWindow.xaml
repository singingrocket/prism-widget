<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Prism.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Prism">

    <Grid x:Name="Root"
          Width="300"
          VerticalAlignment="Top"
          Background="Transparent"
          PointerEntered="Root_PointerEntered"
          PointerExited="Root_PointerExited"
          PointerPressed="Root_PointerPressed"
          PointerMoved="Root_PointerMoved"
          PointerReleased="Root_PointerReleased"
          PointerCaptureLost="Root_PointerCaptureLost">

        <Grid.ContextFlyout>
            <MenuFlyout x:Name="WidgetMenu" ShouldConstrainToRootBounds="False" Opening="WidgetMenu_Opening"
                        Opened="WidgetMenu_Opened" Closed="WidgetMenu_Closed">
                <ToggleMenuFlyoutItem x:Name="AlwaysOnTopItem" Text="Always on top" Click="AlwaysOnTopItem_Click" />
                <ToggleMenuFlyoutItem x:Name="LockItem" Text="Lock position" Click="LockItem_Click" />
                <ToggleMenuFlyoutItem x:Name="ClickThroughItem" Text="Click-through" Click="ClickThroughItem_Click" />
                <ToggleMenuFlyoutItem x:Name="MoveAwayItem" Text="Move away from mouse" Click="MoveAwayItem_Click" />
                <ToggleMenuFlyoutItem x:Name="StartupItem" Text="Start with Windows" Click="StartupItem_Click" />
                <MenuFlyoutSubItem x:Name="TransparencyMenu" Text="Transparency">
                    <RadioMenuFlyoutItem Text="Frosted" GroupName="Transparency" Tag="0" Click="TransparencyItem_Click" />
                    <RadioMenuFlyoutItem Text="Medium" GroupName="Transparency" Tag="0.4" Click="TransparencyItem_Click" />
                    <RadioMenuFlyoutItem Text="Clear" GroupName="Transparency" Tag="0.7" Click="TransparencyItem_Click" />
                    <RadioMenuFlyoutItem Text="Crystal" GroupName="Transparency" Tag="1" Click="TransparencyItem_Click" />
                </MenuFlyoutSubItem>
                <MenuFlyoutSubItem x:Name="SpectrumMenu" Text="Spectrum">
                    <RadioMenuFlyoutItem Text="Off" GroupName="Spectrum" Tag="Off" Click="SpectrumItem_Click" />
                    <RadioMenuFlyoutItem Text="Speakers" GroupName="Spectrum" Tag="Speakers" Click="SpectrumItem_Click" />
                    <RadioMenuFlyoutItem Text="Microphone" GroupName="Spectrum" Tag="Microphone" Click="SpectrumItem_Click" />
                </MenuFlyoutSubItem>
                <MenuFlyoutItem Text="Open follow-up history" Click="FollowUpHistoryButton_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Hide widget" Click="HideItem_Click" />
                <MenuFlyoutItem Text="Exit" Click="ExitItem_Click" />
            </MenuFlyout>
        </Grid.ContextFlyout>

        <!-- Specular sheen on top of the acrylic -->
        <Border x:Name="Sheen" IsHitTestVisible="False" CornerRadius="{StaticResource WidgetCornerRadius}">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0.9,0.8">
                    <GradientStop Color="#73FFFFFF" Offset="0" />
                    <GradientStop Color="#1AFFFFFF" Offset="0.45" />
                    <GradientStop Color="#00FFFFFF" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <StackPanel Padding="20,14,20,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="TimeText"
                           Text="10:42"
                           FontSize="56"
                           FontWeight="SemiBold"
                           CharacterSpacing="-30"
                           LineHeight="54"
                           LineStackingStrategy="BlockLineHeight" />
                <TextBlock x:Name="AmPmText"
                           Text="AM"
                           FontSize="18"
                           FontWeight="Medium"
                           Opacity="0.55"
                           Margin="6,0,0,6"
                           VerticalAlignment="Bottom" />
            </StackPanel>

            <TextBlock x:Name="DateText" Text="Thursday, November 5" FontSize="15" Opacity="0.7" Margin="0,2,0,0" />
            <TextBlock x:Name="TimeZoneText" Text="India Standard Time · UTC+05:30" FontSize="12" Opacity="0.5"
                       Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />

            <!-- Notifications: collapsed summary row; click to expand -->
            <Button x:Name="NotificationsHeader" Style="{StaticResource PanelHeaderStyle}" Margin="-8,6,-8,0"
                    Click="NotificationsHeader_Click">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xEA8F;" FontSize="13" Opacity="0.65" VerticalAlignment="Center" />
                    <TextBlock x:Name="NotificationsSummaryText" Grid.Column="1" Text="Notifications" FontSize="13"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <StackPanel x:Name="FollowUpBadge" Grid.Column="2" Orientation="Horizontal" Spacing="3"
                                VerticalAlignment="Center" Visibility="Collapsed"
                                ToolTipService.ToolTip="Follow-ups">
                        <FontIcon Glyph="&#xE735;" FontSize="12" Foreground="{StaticResource FollowUpBrush}" />
                        <TextBlock x:Name="FollowUpBadgeText" Text="0" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource FollowUpTextBrush}" />
                    </StackPanel>
                    <FontIcon x:Name="NotificationsChevron" Grid.Column="3" Glyph="&#xE70D;" FontSize="10" Opacity="0.6"
                              VerticalAlignment="Center" />
                </Grid>
            </Button>

            <StackPanel x:Name="NotificationsPanel" Visibility="Collapsed" Spacing="6" Margin="0,4,0,0">
                <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto" Margin="-4,0,-8,0" Padding="4,0,8,0">
                    <StackPanel Spacing="6">
                        <!-- Starred notifications and manual follow-ups, kept until marked done -->
                        <StackPanel x:Name="FollowUpsSection" Spacing="6" Margin="0,0,0,4">
                            <Grid>
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE735;" FontSize="13" Foreground="{StaticResource FollowUpBrush}" />
                                    <TextBlock Text="Follow-ups" FontSize="14" FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock x:Name="FollowUpDueText" FontSize="11" Opacity="0.6" VerticalAlignment="Center" />
                                    <HyperlinkButton x:Name="FollowUpHistoryButton" Content="History" FontSize="12" Padding="6,2"
                                                     ToolTipService.ToolTip="Open the follow-up history file"
                                                     Click="FollowUpHistoryButton_Click" />
                                </StackPanel>
                            </Grid>
                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="NewFollowUpBox" PlaceholderText="Add a follow-up…" FontSize="12"
                                         MaxLength="300" KeyDown="NewFollowUpBox_KeyDown" />
                                <Button x:Name="AddFollowUpButton" Grid.Column="1" Padding="8,6" VerticalAlignment="Stretch"
                                        ToolTipService.ToolTip="Add follow-up" AutomationProperties.Name="Add follow-up"
                                        Click="AddFollowUpButton_Click">
                                    <FontIcon Glyph="&#xE710;" FontSize="12" />
                                </Button>
                            </Grid>
                            <StackPanel x:Name="FollowUpsList" Spacing="6" />
                        </StackPanel>

                        <Grid x:Name="NotificationsToolbar">
                            <TextBlock Text="Notifications" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <HyperlinkButton x:Name="ClearAllButton" Content="Clear all" FontSize="12" Padding="6,2"
                                             HorizontalAlignment="Right" Click="ClearAllButton_Click" />
                        </Grid>
                        <StackPanel x:Name="NotificationsList" Spacing="8" />
                    </StackPanel>
                </ScrollViewer>
                <TextBlock x:Name="NotificationsMessage" FontSize="12" Opacity="0.65" TextWrapping="Wrap"
                           IsTextSelectionEnabled="True" Visibility="Collapsed" />
                <Button x:Name="NotificationSettingsButton" Content="Open notification settings"
                        HorizontalAlignment="Stretch" Visibility="Collapsed" Click="NotificationSettingsButton_Click" />
            </StackPanel>

            <!-- Spectrum strip along the bottom edge; bars are added in code -->
            <Grid x:Name="SpectrumStrip"
                  Height="30"
                  Margin="-10,6,-10,-12"
                  ColumnSpacing="2"
                  Opacity="0"
                  Visibility="Collapsed"
                  IsHitTestVisible="False">
                <Grid.OpacityTransition>
                    <ScalarTransition Duration="0:0:0.4" />
                </Grid.OpacityTransition>
            </Grid>
        </StackPanel>

        <!-- Battery badge (swaps with the hover tools) -->
        <StackPanel x:Name="BatteryBadge"
                    Orientation="Horizontal"
                    Spacing="5"
                    Margin="0,12,16,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    IsHitTestVisible="False">
            <StackPanel.OpacityTransition>
                <ScalarTransition />
            </StackPanel.OpacityTransition>
            <Grid Width="27" Height="12" VerticalAlignment="Center">
                <Border Width="24" HorizontalAlignment="Left"
                        BorderBrush="#8C000000" BorderThickness="1.2" CornerRadius="4" Padding="1.5">
                    <Rectangle x:Name="BatteryFill" Width="15" HorizontalAlignment="Left"
                               RadiusX="1.5" RadiusY="1.5" Fill="#2FB35A" />
                </Border>
                <Border Width="2" Height="4" HorizontalAlignment="Right" Margin="0,0,1,0"
                        CornerRadius="0,1,1,0" Background="#8C000000" />
            </Grid>
            <TextBlock x:Name="BatteryPercentText" Text="78%" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
            <FontIcon x:Name="ChargingIcon" Glyph="&#xE945;" FontSize="11" Opacity="0.7" VerticalAlignment="Center" />
        </StackPanel>

        <!-- Grab side for "Move away from mouse": approaching from here doesn't push the widget away -->
        <Border x:Name="GrabHandle"
                Width="4"
                Height="32"
                Margin="0,0,4,0"
                CornerRadius="2"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Background="#40000000"
                Visibility="Collapsed"
                IsHitTestVisible="False" />

        <!-- Soft glass edge; also hides the stepped pixels of the rounded window shape -->
        <Border IsHitTestVisible="False" BorderThickness="1" CornerRadius="{StaticResource WidgetCornerRadius}">
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#F2FFFFFF" Offset="0" />
                    <GradientStop Color="#99FFFFFF" Offset="0.5" />
                    <GradientStop Color="#66FFFFFF" Offset="1" />
                </LinearGradientBrush>
            </Border.BorderBrush>
        </Border>

        <!-- Hover tools -->
        <StackPanel x:Name="Tools"
                    Orientation="Horizontal"
                    Spacing="6"
                    Margin="0,8,10,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Opacity="0">
            <StackPanel.OpacityTransition>
                <ScalarTransition />
            </StackPanel.OpacityTransition>
            <Button x:Name="PinButton" Style="{StaticResource ToolButtonStyle}" Click="PinButton_Click"
                    ToolTipService.ToolTip="Always on top">
                <FontIcon x:Name="PinGlyph" Glyph="&#xE840;" FontSize="12" />
            </Button>
            <Button x:Name="SettingsButton" Style="{StaticResource ToolButtonStyle}" Click="SettingsButton_Click"
                    ToolTipService.ToolTip="Options">
                <FontIcon Glyph="&#xE713;" FontSize="12" />
            </Button>
        </StackPanel>
    </Grid>
</Window>
