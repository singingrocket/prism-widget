<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Prism.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Light">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <CornerRadius x:Key="WidgetCornerRadius">16</CornerRadius>

            <LinearGradientBrush x:Key="SpectrumBarBrush" StartPoint="0,1" EndPoint="0,0">
                <GradientStop Color="#D94C78FF" Offset="0" />
                <GradientStop Color="#B3A56EFF" Offset="1" />
            </LinearGradientBrush>

            <Style x:Key="ToolButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Width" Value="28" />
                <Setter Property="Height" Value="28" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Background" Value="#8CFFFFFF" />
                <Setter Property="BorderBrush" Value="#CCFFFFFF" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
