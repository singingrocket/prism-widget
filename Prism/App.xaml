<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Prism.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Light">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <CornerRadius x:Key="WidgetCornerRadius">16</CornerRadius>

            <LinearGradientBrush x:Key="SpectrumBarBrush" StartPoint="0,1" EndPoint="0,0">
                <GradientStop Color="#D94C78FF" Offset="0" />
                <GradientStop Color="#B3A56EFF" Offset="1" />
            </LinearGradientBrush>

            <Style x:Key="ToolButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Width" Value="28" />
                <Setter Property="Height" Value="28" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Background" Value="#8CFFFFFF" />
                <Setter Property="BorderBrush" Value="#CCFFFFFF" />
            </Style>

            <Style x:Key="PanelHeaderStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="8,4" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>

            <!-- Notification Center-style card -->
            <SolidColorBrush x:Key="NotificationCardBrush" Color="#A6FFFFFF" />
            <SolidColorBrush x:Key="NotificationCardBorderBrush" Color="#14000000" />

            <!-- Follow-ups (starred notifications) -->
            <SolidColorBrush x:Key="FollowUpBrush" Color="#F5A524" />
            <SolidColorBrush x:Key="FollowUpTextBrush" Color="#9A5B00" />
            <SolidColorBrush x:Key="FollowUpCardBrush" Color="#BFFFF4DC" />
            <SolidColorBrush x:Key="FollowUpCardBorderBrush" Color="#66F5A524" />
            <SolidColorBrush x:Key="FollowUpDueBrush" Color="#40F5A524" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
